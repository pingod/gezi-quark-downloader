<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="GeZi.Avalonia.CloseConfirmWindow"
        Title="关闭窗口"
        Width="400" Height="210"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="#1B1D21">
  <Window.Styles>
    <Style Selector="TextBlock"><Setter Property="Foreground" Value="#E8EAED" /></Style>
    <Style Selector="TextBlock.dim"><Setter Property="Foreground" Value="#98A0AA" /></Style>
    <Style Selector="Button">
      <Setter Property="Background" Value="#2A2E35" />
      <Setter Property="Foreground" Value="#E8EAED" />
      <Setter Property="BorderBrush" Value="#3C4148" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="14,8" />
    </Style>
    <Style Selector="Button.accent">
      <Setter Property="Background" Value="#2E7CF6" />
      <Setter Property="BorderBrush" Value="#2E7CF6" />
      <Setter Property="Foreground" Value="White" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,*,Auto" Margin="22">
    <TextBlock Grid.Row="0" Text="要关闭窗口吗？" FontSize="16" FontWeight="SemiBold" />

    <TextBlock Grid.Row="1" Classes="dim" TextWrapping="Wrap" FontSize="13" Margin="0,10,0,0"
               Text="收进托盘可以继续下载。这个选择会被记住，之后可在「设置 → 关闭窗口时」修改。" />

    <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,16,0,0">
      <Button Grid.Column="1" Content="取消" Margin="0,0,8,0" Click="OnCancelClick" />
      <Button Grid.Column="2" Content="直接退出" Margin="0,0,8,0" Click="OnExitClick" />
      <Button Grid.Column="3" Content="收进托盘" Classes="accent" Click="OnHideClick" />
    </Grid>
  </Grid>
</Window>
