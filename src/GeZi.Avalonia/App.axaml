<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="GeZi.Avalonia.App"
             RequestedThemeVariant="Dark">
  <!-- 默认深色（与 WPF 版的深色主题观感接近）；设置页可切成浅色。 -->
  <Application.Styles>
    <FluentTheme />
  </Application.Styles>
</Application>
