<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net48;net8.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>GeZi.Providers</AssemblyName>
    <RootNamespace>GeZi.Providers</RootNamespace>
    <Product>鸽子下载</Product>
    <AssemblyTitle>鸽子下载</AssemblyTitle>
    <Version>2.4.0</Version>
    <!-- 与主程序一致：统一 x64（混用位数会 0x8007000B）。 -->
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <PathMap>$(MSBuildProjectDirectory)=/_/</PathMap>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GeZi.Core\GeZi.Core.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="System.Net.Http" />
    <!-- JSON：与 Core 一致用框架自带 JavaScriptSerializer -->
    <Reference Include="System.Web.Extensions" />
    <!-- 阿里云盘设备签名（secp256k1）的模运算 -->
    <Reference Include="System.Numerics" />
    <!-- 迅雷登录窗口/协议里用到（保持与 Core 相同集合，避免漏引用） -->
    <Reference Include="System.Security" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <!-- 二维码解码走 NuGet 版（netstandard2.0 目标提供纯字节 RGBLuminanceSource，
         不碰 System.Drawing —— 那套在 Linux 上不可用）。
         与 GeZi.Core 的 net8.0 分支固定同一版本，避免解析出两份 native 库。 -->
    <PackageReference Include="ZXing.Net" Version="0.16.10" />
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="3.119.4" />
    <!-- Cloud 层的图片解码（Support/ImageLoader 在 Core，此处只保证版本一致） -->
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <!-- ★ 二维码解码：ZXing.Net（Apache-2.0）。只有 QrDecoder 用它，所以跟着本项目的 Qr 目录走。 -->
    <Reference Include="ZXing">
      <HintPath>lib\ZXing\zxing.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

</Project>
