<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 双目标：
         • net48  → Windows（WPF 版 GeZi.exe）的正式产物，保持原样
         • net8.0 → Linux / macOS 原生版（GeZi.Avalonia）复用同一份核心逻辑
         核心本身不含 UI，平台差异集中在 4 处，全部用 #if 分流且各有说明：
           1) JSON      JavaScriptSerializer → System.Text.Json     (Support/JsonCompat.cs)
           2) 密钥加密  DPAPI               → AES-GCM + 本机密钥文件 (Support/SecretProtector.cs)
           3) 图片解码  GDI+                → SkiaSharp              (Support/ImageLoader.cs)
           4) OpenSSL   libssl-3-x64.dll    → 系统 libssl.so.3       (Support/OpenSslTls.cs) -->
    <TargetFrameworks>net48;net8.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>GeZi.Core</AssemblyName>
    <RootNamespace>GeZi.Core</RootNamespace>
    <Product>鸽子下载</Product>
    <AssemblyTitle>鸽子下载</AssemblyTitle>
    <Version>2.4.4</Version>
    <!-- 与主程序保持一致：统一 x64。
         纯托管库其实 AnyCPU 也能用，但混用位数是 0x8007000B（"格式不正确"）这类
         错误的温床 —— 主程序曾因默认 AnyCPU 而实际以 32 位运行，
         加载 x64 的 WebView2Loader.dll 时直接失败。 -->
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- PathMap：别让编译机的绝对路径（含用户名）进产物。
         不加 → `C:\Users\<用户名>\Desktop\GeZi\src\...\GeZi.Core.pdb` 被写进 dll
         → 打包发给别人时泄漏本机用户名/目录（本轮实测发现）。详见 GeZi.csproj 里的说明。 -->
    <PathMap>$(MSBuildProjectDirectory)=/_/</PathMap>
    <!-- SYSLIB0014：`ServicePointManager.FindServicePoint` 在 net8.0 被标记过时。
         本文件里的用法是给 HttpWebRequest 的 ServicePoint 挂 BindIPEndPointDelegate，
         用来统计「同一域名的多个对端 IP」—— 那是**诊断**用途，且下载数据面本身
         走 HttpWebRequest（net48 路径的既有实现）。换成 HttpClient 等于重写整个
         自研引擎的连接统计，不属于本次合并范围。
         net48 侧没有这条分析器规则，所以只在 net8.0 下抑制。 -->
    <NoWarn Condition="'$(TargetFramework)' == 'net8.0'">$(NoWarn);SYSLIB0014</NoWarn>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <!-- 零 NuGet 依赖，可离线编译：JSON 用框架自带 JavaScriptSerializer；HTTP 用 System.Net.Http -->
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Web.Extensions" />
    <!-- DPAPI（ProtectedData）加密 Cookie -->
    <Reference Include="System.Security" />
    <!-- System.Text.Json：net48 不自带，但清理队列等需要它做序列化。
         用 NuGet 版（纯托管，无原生依赖），net8.0 侧用框架自带的。 -->
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
    <!-- 诊断包 zip（ZipArchive） -->
    <Reference Include="System.IO.Compression" />
    <!-- 阿里云盘设备签名（secp256k1）用 BigInteger 做点运算与 recovery id 推导。
         ECDSA 本身交给 ECDsaCng（Windows CNG 原生支持 secp256k1），
         只有「从签名反推公钥点」这一步需要手写模运算。 -->
    <Reference Include="System.Numerics" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <!--
      net8.0 分支的两个 NuGet 依赖：

      • ZXing.Net —— 与 net48 用的是同一套 API，但 net48 那份是固化的 zxing.dll
        （带 GDI+ 绑定）。这里必须走 NuGet 版，因为它的 netstandard2.0 目标
        才提供 RGBLuminanceSource 这条纯字节数组通道 —— 我们已把图像管线
        全部改成喂字节数组（见 Support/QrDecoder.cs），彻底不碰 System.Drawing。

      • SkiaSharp —— 仅用于**解码图片文件**（Support/ImageLoader.cs）。
        Avalonia 本身就把 libSkiaSharp 带进输出目录，所以这里等于零额外体积。
        固定版本与 Avalonia 12 的依赖保持一致，避免解析出两份 native 库。
    -->
    <PackageReference Include="ZXing.Net" Version="0.16.10" />
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="3.119.4" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <!--
      ★ 二维码解码：ZXing.Net（Apache-2.0）★ 仅 net48：net8.0 走 NuGet 版（见上）
      ==================================================================
      夸克分享有时只给一张二维码图片、不给文本链接，
      用户需要把图里的链接抠出来。解码要处理透视校正 + Reed-Solomon 纠错，
      自己写成本远高于编码（QrEncoder 那种），所以用成熟库。

      本项目约定「零 NuGet、离线可构建」。
      因此把 net48 版 zxing.dll（532KB，单文件零依赖）固化进 lib/ZXing/，
      用普通 Reference 引用 —— 任何机器 clone 下来直接 build，不需联网还原。
      详见 lib/ZXing/README.md（含版本 / 许可 / 重新获取方式）。

      ⚠️ net48 下 ZXing 走 System.Drawing 路径，不需要任何 Bindings 包
         （SkiaSharp / Windows.Compatibility 那些只对 .NET 5+ 必要）。
      ⚠️ Private=true 确保 zxing.dll 被复制到输出目录（跟 GeZi.Core.dll 同级）。
      ⚠️ 这里的文件名**刻意用小写 zxing.dll**（与 <AssemblyName>ZXing</AssemblyName> 的大小写不同）：
         GeZi.exe 通过 ProjectReference 拿到它时，MSBuild 会按程序集名规范化成小写 ——
         源码这边跟着写小写，最终产物名才在各平台/打包工具下**完全一致**，
         不会出现"源码是大写、输出是小写"这种大小写不敏感文件系统上才看不出来的坑。
    -->
    <Reference Include="ZXing">
      <HintPath>lib\ZXing\zxing.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- （2026-10-11）原「换 Cookie 辅助脚本 + 内置 CPython」已整体移除 ——
         改用 P/Invoke 直调固化的 OpenSSL 3.5.7（见 lib/OpenSSL 与 Support/OpenSslTls.cs），
         指纹与原来完全一致，但不再需要解释器/脚本/子进程。 -->
  </ItemGroup>

  <ItemGroup>

    <!-- ============================================================
         OpenSSL 3.5.7（2026-10-11 新增）—— 取代内置 CPython 的通道
         ============================================================
         用途：P/Invoke 发**唯一一个**必须过 pan.quark.cn 那道墙的请求
              （扫码登录换登录态 + 取账号昵称/头像）。见 Support/OpenSslTls.cs
              与 Api/PanAccountBridge.cs。

         ⚠️ 为什么必须是这一份、不能换：
             pan.quark.cn 的 ALB 按 TLS ClientHello 的 **supported_groups 扩展大小**
             过滤（阈值约 1600 字节）。实测（2026-10-11，均强制直连）：
               SChannel（.NET / Windows curl）      ❌ RST
               OpenSSL 3.0.18（系统 Python 3.14）    ❌ 连接被强制关闭（约 1500B）
               BouncyCastle 2.7（纯托管 TLS）        ❌
               OpenSSL 3.5.7（本目录这份）           ✅ HTTP 200
             3.5.7 默认启用后量子混合密钥交换（X25519MLKEM768），扩展才够大。

         ⚠️ 必须复制到**输出根目录**：DllImport("libssl-3-x64.dll") 只在 exe 同目录找。
         ⚠️ 是 x64 DLL → 进程必须 64 位（AnyCPU 在 64 位系统上即为 x64）。
         ⚠️ 打包白名单（GeZiTest/package.py 的 KEEP_FILES / deploy.py）要同步这两个文件名！
    -->
    <None Include="lib\OpenSSL\*.dll" Condition="'$(TargetFramework)' == 'net48'">
      <Link>%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
